{
  "name": "@torrix/server",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/sdk.ts",
    "./testing": "./test/helpers.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
