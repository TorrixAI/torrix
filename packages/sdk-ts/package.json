{
  "name": "torrix-sdk",
  "version": "1.1.1",
  "description": "TypeScript SDK for Torrix, self-hosted observability for AI agents: record OpenAI, Anthropic and Vercel AI SDK calls with zero dependencies",
  "license": "MIT",
  "keywords": [
    "llm",
    "observability",
    "ai-agents",
    "openai",
    "anthropic",
    "vercel-ai-sdk",
    "tracing",
    "cost",
    "self-hosted"
  ],
  "homepage": "https://github.com/TorrixAI/torrix/blob/main/docs/integrations/typescript-sdk.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TorrixAI/torrix.git",
    "directory": "packages/sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/TorrixAI/torrix/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
