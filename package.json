{
  "name": "torrix",
  "version": "1.5.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter @torrix/web build",
    "start": "bun run --cwd packages/server start",
    "test": "bun run --cwd packages/server test",
    "test:sdk": "bun run --cwd packages/sdk-ts test",
    "test:web": "bun run --cwd packages/web test",
    "typecheck": "bun run --filter '*' typecheck",
    "ledger:verify": "bun scripts/verify-ledger.ts",
    "compile": "bun scripts/compile.ts",
    "compile:all": "bun scripts/compile.ts --all",
    "test:plugin": "bun run --cwd packages/claude-code-plugin test",
    "test:py": "cd packages/sdk-python && python -m unittest discover -s tests -t .",
    "anchor:verify": "bun scripts/verify-anchor.ts"
  }
}
